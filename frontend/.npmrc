# Force IPv4 only for npm operations
# Note: DNS resolution order is set via NODE_OPTIONS environment variable
# `network-timeout` was a yarn/pnpm key; npm 11+ rejects it as unknown.
# The retry knobs below are still valid npm config keys.
fetch-retries=3
fetch-retry-mintimeout=20000

# eslint-plugin-react@7.x peer-pins eslint to <=9.7, but eslint v10
# is API-compatible for the rules we use. Until eslint-plugin-react
# publishes a v10-compatible peer range, allow `npm ci` to install
# this graph despite the peer mismatch.
legacy-peer-deps=true
