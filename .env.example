# OpenMakerSuite Environment Configuration
# Copy this file to .env and modify values for your environment

# =====================================
# CORE APPLICATION SETTINGS
# =====================================

# Django Secret Key - MUST be changed in production!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Application Mode
DEBUG=1                           # Set to 0 in production
DEVELOPMENT_MODE=0                # Set to 1 only for local development (allows unauthenticated API access)

# Allowed Hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend URL (used for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Postmark inbound webhook token. Must match the `?token=` query param or
# `X-Postmark-Webhook-Token` header Postmark is configured to send to
# /api/inventory/webhooks/postmark-inbound-work-order/. Leave blank in
# environments that don't accept inbound emailed work orders.
POSTMARK_INBOUND_TOKEN=

# =====================================
# OUTBOUND EMAIL (Postmark via django-anymail)
# =====================================

# Email backend. Leave as the console backend for development to print
# outgoing mail to the Django log. In production, set to
# anymail.backends.postmark.EmailBackend to route through Postmark.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Postmark server token for outbound transactional mail. Required when
# EMAIL_BACKEND is anymail.backends.postmark.EmailBackend.
POSTMARK_SERVER_TOKEN=

# Default "From:" address for system-generated mail (reorder notifications, etc.).
# Must be a verified Postmark sender signature in production.
DEFAULT_FROM_EMAIL=noreply@openmakersuite.example

# =====================================
# DATABASE CONFIGURATION
# =====================================

# Database Connection
# Development (SQLite): sqlite:///db.sqlite3
# Production (PostgreSQL): postgresql://username:password@host:port/database
DATABASE_URL=postgresql://makerspace:development_password_only@localhost:5432/makerspace_inventory

# PostgreSQL Settings (when using PostgreSQL)
POSTGRES_DB=makerspace_inventory
POSTGRES_USER=makerspace
POSTGRES_PASSWORD=development_password_only

# =====================================
# REDIS & CELERY CONFIGURATION
# =====================================

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0

# =====================================
# MONITORING & ERROR TRACKING
# =====================================

# Sentry Error Tracking (Backend)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# =====================================
# FRONTEND CONFIGURATION
# =====================================

# API Connection
REACT_APP_API_URL=http://localhost:8000

# Sentry Error Tracking (Frontend)
REACT_APP_SENTRY_DSN=

# =====================================
# TV DASHBOARD CUSTOMIZATION

# Location-Specific Dashboard Configuration
# Each location can have its own title, subtitle, and logo
# Use UPPERCASE location names in environment variable names

# Example for Woodshop location (/tv-dashboard/woodshop)
# REACT_APP_DASHBOARD_TITLE_WOODSHOP=Dallas Makerspace - Woodshop
# REACT_APP_DASHBOARD_SUBTITLE_WOODSHOP=Wood & Tools Inventory
# REACT_APP_DASHBOARD_LOGO_WOODSHOP=https://example.com/woodshop-logo.png

# Example for Electronics location (/tv-dashboard/electronics)
# =====================================

# Dashboard Branding
REACT_APP_DASHBOARD_TITLE=Dallas Makerspace Inventory
REACT_APP_DASHBOARD_SUBTITLE=Items on Order
REACT_APP_DASHBOARD_LOGO=
REACT_APP_SHOW_LOGO=true
REACT_APP_SHOW_TRANSPARENCY=true

# Dashboard Messages
# JSON array format: ["Message 1", "Message 2", "Message 3"]
REACT_APP_FOOTER_MESSAGES=["Tracking items from request to delivery", "Scan QR codes to request reorders", "Keeping your makerspace stocked", "Real-time inventory management", "Automated supply chain tracking"]

# Message rotation interval (seconds)
REACT_APP_MESSAGE_ROTATION_SECONDS=10

# =====================================
# DOCKER & DEPLOYMENT SETTINGS
# =====================================

# These are used by docker-compose and deployment scripts
# Usually you don't need to modify these for local development

# Container Settings
COMPOSE_PROJECT_NAME=openmakersuite

# Automatic HTTPS (optional, used in production deployments)
LETSENCRYPT_EMAIL=
LETSENCRYPT_DOMAINS=

# =====================================
# FORGEKEY DEVICE INTEGRATION
# =====================================

# Shared provisioning secret for ESP32 device enrollment. Devices send this
# in the X-ForgeKey-Provisioning-Token header when calling
# POST /api/forgekey/devices/register/. Empty value disables registration.
FORGEKEY_PROVISIONING_TOKEN=

# Per-device JWT signing secret base. JWT issued at registration is signed
# with sha256(mac + ":" + FORGEKEY_SHARED_SECRET).
FORGEKEY_SHARED_SECRET=change-me-in-production

# Retention window (days) for ESP32DevicePhoto rows. The
# prune_device_photos celery task deletes anything older than this.
FORGEKEY_PHOTO_RETENTION_DAYS=30

# ECDSA(P-256) firmware signing key (PEM, with literal \n for newlines so the
# value fits on one .env line). Generate with
# scripts/build/gen-firmware-signing-key.sh in the forgekey repo. The matching
# public key is baked into device firmware via src/security/firmware_pubkey.h
# and is used to verify signatures on dispatched firmware. NEVER commit the
# private key, and use a separate value per environment. Leaving this empty
# in development is fine; production deployments MUST set it.
FORGEKEY_FIRMWARE_SIGNING_KEY=

# MQTT broker — backend publishes firmware updates to forgekey/<mac>/firmware
# and listens on the same prefix for device pings. Same broker also serves
# the existing ForgeKey command/status traffic. In production, the EMQX
# service (see docker-compose.prod.yml) is reachable at hostname `emqx`.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=
MQTT_TOPIC_PREFIX=forgekey
MQTT_CLIENT_ID=forgekey-server
MQTT_KEEPALIVE=60

# EMQX broker — initial dashboard password (default user: `admin`) plus an
# API key/secret pair the backend uses to call the EMQX REST API at
# http://emqx:18083/api/v5 (e.g. to inspect connections or publish from
# admin tools). Generate the key/secret in the EMQX dashboard under
# `System > API Keys` after first deploy. See docs/forgekey-integration.md.
EMQX_DASHBOARD_PASSWORD=
EMQX_API_KEY=
EMQX_API_SECRET=

# =====================================
# PRODUCTION DEPLOYMENT OVERRIDES
# =====================================
# For production deployments, override the following:

# Production Database Example:
# DATABASE_URL=postgresql://prod_user:secure_password@prod-db-host:5432/makerspace_inventory

# Production Redis Example:
# REDIS_URL=redis://prod-redis-host:6379/0
# CELERY_BROKER_URL=redis://prod-redis-host:6379/0

# Production Security:
# DEBUG=0
# DEVELOPMENT_MODE=0
# SECRET_KEY=your-super-secure-random-key-here
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Production Monitoring:
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# REACT_APP_SENTRY_DSN=https://your-frontend-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# Production Frontend:
# REACT_APP_API_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com

# =====================================
# NOTES
# =====================================
#
# 1. Never commit the actual .env file to version control
# 2. Always use strong, unique passwords in production
# 3. Generate a new SECRET_KEY for each environment
# 4. Set DEBUG=0 and DEVELOPMENT_MODE=0 in production
# 5. Configure proper ALLOWED_HOSTS for your domain
# 6. Set up Sentry for error monitoring in production
# 7. Use managed database and Redis services in production
# 8. Customize dashboard branding for your makerspace
