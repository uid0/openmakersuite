  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --port 3000",
    "test": "TZ=America/Chicago vitest",
    "test:coverage": "TZ=America/Chicago vitest run --coverage",
    "test:ci": "TZ=America/Chicago vitest run",
    "test:ci:coverage": "TZ=America/Chicago vitest run --coverage",
    "test:fast": "TZ=America/Chicago vitest run --bail=1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:trace": "PLAYWRIGHT_TRACE=on playwright test",
    "test:e2e:video": "PLAYWRIGHT_VIDEO=on playwright test",
    "test:e2e:record": "playwright codegen http://localhost:3000",
    "test:e2e:show-report": "playwright show-report",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "postinstall": "patch-package",
    "prepare": "cd .. && (test -e .git && husky) || true"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
