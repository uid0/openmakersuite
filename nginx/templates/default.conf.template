upstream backend {
    server backend:8000;
}

upstream emqx_dashboard {
    server emqx:18083;
}

server {
    listen 80;
    server_name ${LETSENCRYPT_DOMAINS};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${LETSENCRYPT_DOMAINS};

    # Stable path maintained by docker-entrypoint.d/10-letsencrypt.sh — symlinks
    # that always point at the current Let's Encrypt lineage (never a pinned
    # -00NN number), so renewals require no config edit or hand redeploy.
    ssl_certificate /etc/letsencrypt/nginx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/nginx/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    root /app/frontend;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://highlighter.openmakersuite.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://highlighter.openmakersuite.net; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    # Allow the V8 sampling profiler so @sentry/react browserProfilingIntegration()
    # can collect flame charts. Without this header the SDK silently emits
    # empty profiles. Document-Policy applies to the HTML document only;
    # the static-asset location blocks below override `add_header` and so
    # don't need (and shouldn't carry) this directive.
    add_header Document-Policy "js-profiling" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /mqttadmin {
        return 301 $scheme://$host/mqttadmin/;
    }

    location /mqttadmin/ {
        proxy_pass http://emqx_dashboard/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }

    # Slashless /admin must redirect to /admin/ before the SPA catch-all sees
    # it — otherwise the React shell loads, React-Router has no route for
    # /admin, and the service worker can cache the resulting blank page.
    location = /admin {
        return 301 $scheme://$host/admin/;
    }

    location /admin/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # WebAuthn / passkey endpoints served by django-passkey-auth, mounted at
    # /auth/passkey/ in backend/config/urls.py. Without this block requests
    # fall through to the SPA catch-all and the browser receives index.html
    # instead of JSON, silently breaking the admin Register Passkey button.
    location /auth/passkey/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location /webhooks/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location /flower/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /django-static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    # VENDOR PAPERWORK IS NOT PUBLIC MEDIA (op-anonymous-read-posture).
    #
    # These prefixes hold supplier agreements, purchase-order invoices,
    # out-of-pocket purchase receipts, third-party work-order invoices and
    # quotes, maintenance-record invoices, work-order attachments, and the raw
    # PDFs the Postmark inbound webhook files verbatim — a vendor's identity and
    # what we pay them, as files. nginx answers /media/ before Django sees it,
    # so no `permission_classes` change reaches them: verified by running this
    # config's previous /media/ block and fetching a signed agreement with no
    # session (HTTP 200, full body).
    #
    # `auth_request` puts a session check in front of the bytes while leaving
    # the PATH unchanged, so no payload, no stored file_url and no consumer
    # moves. `login_user` sets a Django session cookie alongside the JWT (its
    # docstring says so), which is what a browser following an <a href> sends.
    # The same prefix list is enforced in Python by `config.protected_media`
    # for every deployment and test that reaches /media/ without nginx.
    #
    # `^~` so these win over the general /media/ prefix below regardless of
    # ordering, and each repeats the alias/expires/CSP of that block — a
    # `location` does not inherit them from a sibling.
    location ^~ /media/supplier_agreements/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/supplier_agreements/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/purchase_orders/attachments/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/purchase_orders/attachments/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/work_orders/receipts/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/work_orders/receipts/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/index_cards/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/index_cards/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/third_party_work_orders/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/third_party_work_orders/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/inventory/maintenance_records/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/inventory/maintenance_records/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/work_orders/attachments/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/work_orders/attachments/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/work_orders/submissions/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/work_orders/submissions/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location ^~ /media/work_orders/scans/ {
        auth_request /_vendor_media_auth;
        error_page 401 403 = @vendor_media_denied;
        alias /app/media/work_orders/scans/;
        expires -1;
        add_header Cache-Control "private, no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    # A REFUSAL CARRIES A REMEDY (op-anonymous-read-posture).
    #
    # These URLs are followed by a browser from an <a href>, so nginx's stock
    # 403 body is the whole of what the person sees — no SPA error handler runs
    # downstream. An operator whose Django session lapsed under them has done
    # nothing wrong and needs to be told what to do, not shown a blank wall.
    # `config.protected_media._forbidden_with_remedy` returns the same page for
    # the deployment that reaches /media/ without nginx in front.
    #
    # It names NO path, NO filename, NO prefix and NO vendor: the reader knows
    # what they clicked, and anyone else arriving here must learn nothing.
    # `always` on the headers because this is served through error_page.
    #
    # `types { }` IS LOAD-BEARING, NOT TIDINESS. nginx resolves the content type
    # from the URI extension at the GATED location, and the internal redirect
    # here carries that resolved type with it — so `default_type` alone never
    # applies and the remedy went out as application/pdf or image/jpeg, which a
    # browser hands to its PDF or image viewer instead of rendering. Emptying
    # the MIME map in this location leaves nothing to resolve, so `default_type`
    # is what the reader gets. `config/tests/test_protected_media.py` asserts a
    # refused .pdf, .jpg and extension-less path through a running nginx.
    location @vendor_media_denied {
        internal;
        types { }
        default_type text/html;
        add_header Cache-Control "private, no-store" always;
        return 403 '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>Sign in required</title></head><body><h1>Sign in required</h1><p>This document is only available to signed-in members.</p><p><a href="/reauth">Sign in</a> to open it.</p><script>try{sessionStorage.setItem("oms_pending_return_to",window.location.pathname)}catch(e){}</script></body></html>';
    }

    # The subrequest the blocks above make. 204 for a signed-in caller,
    # 403 otherwise; never reachable directly (`internal`), and never cached —
    # a cached 204 here would be an open door for every caller behind the proxy.
    location = /_vendor_media_auth {
        internal;
        proxy_pass http://backend/api/auth/media-access/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.sentry-cdn.com https://js.sentry-cdn.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https:; font-src 'self' data:; connect-src 'self' wss: https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://${SENTRY_HOST}; frame-src 'self' https://www.wunderground.com https://embed.waze.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' https:;" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
