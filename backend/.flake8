[flake8]
max-line-length = 127
exclude =
    */migrations/*,
    __pycache__,
    */venv/*,
    */env/*,
    .git,
    .pytest_cache,
    htmlcov,
    staticfiles,
    media

ignore = E203,W503,E501,D,C901
# E203: Whitespace before ':' (conflicts with black)
# W503: Line break before binary operator (conflicts with black)
# E501: Line too long (handled by black)
# D: Ignore all docstring checks (D101, D102, D104, D105, D106, D200, etc.)
#    For a makerspace project, strict docstring requirements can slow development
# C901: Function complexity checks - allow for complex business logic

max-complexity = 10

# E402: module level import not at top of file
# This is acceptable in files that use django.setup() before importing models
per-file-ignores =
    auth_views.py:E402
    conftest.py:E402
    reorder_queue/models.py:E402
    reorder_queue/tests/factories.py:E402
    reorder_queue/tests/test_api.py:E402
