# Production Environment Configuration for OpenMakerSuite
# Copy this file to .env and update with your production values

# ============================================================================
# Django Security Settings
# ============================================================================

# CRITICAL: Set to 0 in production!
DEBUG=0

# CRITICAL: Generate a strong secret key
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here-change-this

# CRITICAL: Disable development mode in production
DEVELOPMENT_MODE=0

# ============================================================================
# Host Configuration
# ============================================================================

# Comma-separated list of domains that can serve the application
# Include all domains and subdomains that will be used
ALLOWED_HOSTS=dms.openmakersuite.net,www.dms.openmakersuite.net

# CRITICAL for CSRF protection when behind a reverse proxy with HTTPS
# Must include the protocol (https://) and the domain
# Comma-separated list if you have multiple domains
CSRF_TRUSTED_ORIGINS=https://dms.openmakersuite.net,https://www.dms.openmakersuite.net

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://makerspace_user:secure_password@db:5432/makerspace_inventory

# If using Docker Compose, these are also needed for the db service
POSTGRES_DB=makerspace_inventory
POSTGRES_USER=makerspace_user
POSTGRES_PASSWORD=secure_password

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ============================================================================
# Frontend Configuration
# ============================================================================

# URL where the frontend is hosted
FRONTEND_URL=https://dms.openmakersuite.net

# ============================================================================
# Error Tracking (Optional but Recommended)
# ============================================================================

# Sentry DSN for error tracking
# Leave empty to disable Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# ============================================================================
# CI/CD Flag
# ============================================================================

# Set to false in production, true only in CI pipelines
CI=false

# ============================================================================
# Additional Production Settings (Optional)
# ============================================================================

# Outbound email via Postmark (django-anymail). Required for notifications
# such as new reorder-request alerts to SIGs.
EMAIL_BACKEND=anymail.backends.postmark.EmailBackend
POSTMARK_SERVER_TOKEN=your-postmark-server-token
DEFAULT_FROM_EMAIL=noreply@openmakersuite.net

# Inbound work-order webhook from Postmark (server -> us). Set to a long
# random string and configure the same value in the Postmark inbound webhook
# `?token=` parameter. If empty, the inbound endpoint returns 503.
POSTMARK_INBOUND_TOKEN=

# Shared secret for IoT device traffic-count pings (ForgeKey, ESP32, etc.)
# posted to /api/location-checkins/webhook/. Set to a long random string;
# devices send it via the X-Location-Ping-Token header or ?token= query.
# If empty, the endpoint returns 503.
LOCATION_PING_TOKEN=

# Shared provisioning secret for ForgeKey device enrollment. ESP32 firmware
# ships with this baked in (or receives it via captive portal) and posts it
# in the X-ForgeKey-Provisioning-Token header to
# /api/forgekey/devices/register/. If empty, registration returns 401.
FORGEKEY_PROVISIONING_TOKEN=

# How long (in days) to keep periodic surveillance photos uploaded by
# ForgeKey sensor devices before the prune_device_photos celery task
# deletes them. Defaults to 30.
FORGEKEY_PHOTO_RETENTION_DAYS=30

# MQTT broker reachable by both backend (publishes firmware updates) and
# ESP32 sensor devices (subscribe to forgekey/<mac>/firmware). Same broker
# is used for ForgeKey command/status traffic; if MQTT_BROKER_USERNAME is
# empty, an unauthenticated connection is attempted.
MQTT_BROKER_HOST=mqtt.example.org
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=
MQTT_TOPIC_PREFIX=forgekey
MQTT_CLIENT_ID=forgekey-server
MQTT_KEEPALIVE=60

# WHMCS API credentials for the maker box (personal storage bin) flow.
# Without these the /api/maker-boxes/scan/ endpoint returns 503.
WHMCS_API_URL=https://billing.example.org/includes/api.php
WHMCS_API_IDENTIFIER=your-whmcs-identifier
WHMCS_API_SECRET=your-whmcs-secret
WHMCS_API_ACCESSKEY=optional-whmcs-accesskey

# AWS S3 configuration (if using S3 for media files)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
