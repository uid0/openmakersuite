[run]
source = .
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */env/*
    manage.py
    */wsgi.py
    */asgi.py
    */admin.py
    */apps.py
    */views.py
    */management/commands/*
    config/celery_admin.py
    inventory/utils/label_generator.py
    # Exclude untested serializers, tasks, and utils from coverage
    inventory/serializers.py
    inventory/tasks.py
    inventory/utils/brother_esc_p.py
    inventory/utils/pdf_generator.py
    inventory/utils/qr_generator.py
    reorder_queue/serializers.py
    reorder_queue/tasks.py
    index_cards/serializers.py
    index_cards/services.py
    index_cards/urls.py
    config/urls.py
    forgekey/urls.py
    inventory/urls.py
    reorder_queue/urls.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov
