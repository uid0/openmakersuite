FROM node:24-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --production=false

# Copy application code
COPY . .

# Build arguments for environment variables
ARG REACT_APP_API_URL
ARG REACT_APP_GIT_HASH=dev
ARG REACT_APP_GITHUB_URL=https://github.com/uid0/openmakersuite

# Set environment variables for build. CRA inlines REACT_APP_* into the bundle
# at build time — these args must reach the docker-build CI step (oms-78t).
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_GIT_HASH=$REACT_APP_GIT_HASH
ENV REACT_APP_GITHUB_URL=$REACT_APP_GITHUB_URL

# Debug: Print the git hash being used (remove in production if desired)
RUN echo "Building with REACT_APP_GIT_HASH=$REACT_APP_GIT_HASH"

# Build the application
RUN npm run build

# Production stage - copy build to volume location
FROM busybox:latest

WORKDIR /app

# Copy built files from builder to a temporary location
COPY --from=builder /app/build /app/frontend_build

# Copy files to volume on startup to ensure volume is always up to date
# This handles the case where the volume already exists with old files
CMD ["sh", "-c", "cp -r /app/frontend_build/* /app/frontend/ 2>/dev/null || true && while true; do sleep 3600; done"]
