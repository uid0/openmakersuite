{
  "name": "makerspace-inventory-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@highlight-run/react": "^21.0.0",
    "@hookform/resolvers": "^3.3.4",
    "@mantine/core": "^7.11.0",
    "@mantine/dates": "^7.11.0",
    "@mantine/dropzone": "^7.11.0",
    "@mantine/form": "^7.11.0",
    "@mantine/hooks": "^7.11.0",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.35.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "axios": "^1.16.0",
    "axios-mock-adapter": "^2.0.0",
    "dayjs": "^1.11.10",
    "highlight.run": "^9.0.0",
    "html5-qrcode": "^2.3.8",
    "nth-check": ">=2.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.5.3",
    "react-hook-form": "^7.50.0",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "react-swipeable": "^7.0.2",
    "recharts": "^2.15.4",
    "typescript": "^4.9.5",
    "web-vitals": "^5.0.0",
    "zod": "^3.22.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "npx --yes update-browserslist-db@latest",
    "build": "react-scripts build",
    "test": "TZ=America/Chicago react-scripts test --maxWorkers=4",
    "test:coverage": "TZ=America/Chicago react-scripts test --maxWorkers=4 --coverage --watchAll=false",
    "test:ci": "TZ=America/Chicago CI=true react-scripts test --maxWorkers=4 --watchAll=false",
    "test:ci:coverage": "TZ=America/Chicago CI=true react-scripts test --maxWorkers=4 --coverage --watchAll=false",
    "test:fast": "TZ=America/Chicago CI=true react-scripts test --maxWorkers=4 --watchAll=false --bail --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:trace": "PLAYWRIGHT_TRACE=on playwright test",
    "test:e2e:video": "PLAYWRIGHT_VIDEO=on playwright test",
    "test:e2e:record": "playwright codegen http://localhost:3000",
    "test:e2e:show-report": "playwright show-report",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "eject": "react-scripts eject",
    "postinstall": "patch-package",
    "prepare": "cd .. && (test -e .git && husky install) || true"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.test.{ts,tsx}",
          "src/**/__tests__/**/*.{ts,tsx}"
        ],
        "rules": {
          "testing-library/no-node-access": "warn",
          "testing-library/no-wait-for-multiple-assertions": "warn",
          "testing-library/no-container": "warn",
          "jest/no-conditional-expect": "warn"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx",
      "!src/reportWebVitals.ts",
      "!src/types/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 35,
        "functions": 33,
        "lines": 40,
        "statements": 39
      }
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/src/__mocks__/styleMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(axios)/)"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.12.3",
    "@types/react-grid-layout": "^1.3.6",
    "husky": "^9.0.0",
    "iconv-lite": "^0.7.0",
    "identity-obj-proxy": "^3.0.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "postinstall-postinstall": "^2.1.0"
  },
  "overrides": {
    "nth-check": ">=2.0.1",
    "glob": ">=10.5.0",
    "webpack-dev-server": ">=5.2.1",
    "postcss": ">=8.5.10",
    "test-exclude": ">=7.0.1",
    "svgo": "^4.0.0",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.7",
    "node-forge": "1.4.0",
    "uuid": "^14.0.0",
    "brace-expansion": "1.1.13 || ^2.0.3",
    "http-proxy-agent": "^9.0.0",
    "protobufjs": "^8.0.2"
  }
}
